# Copiá este archivo como `server/.env` y completá tus credenciales
# (se mantiene `server/.env.example` como copia para no romper el flujo `cd server && cp .env.example .env`)
PORT=3000
SPOTIFY_CLIENT_ID=tu_client_id
SPOTIFY_CLIENT_SECRET=tu_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
SESSION_SECRET=un_secreto_largo_y_aleatorio
