# Copiá este archivo como `.env` en la raíz y completá tus credenciales
PORT=3000
NODE_ENV=development
SPOTIFY_CLIENT_ID=tu_client_id
SPOTIFY_CLIENT_SECRET=tu_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
SESSION_SECRET=un_secreto_largo_y_aleatorio
TOKEN_ENCRYPTION_KEY=tu_clave_hex_de_64_caracteres
# Generarla con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
